{
  "name": "tav-press-form",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generate-seo-pages.mjs && node scripts/prepare-sites-build.mjs",
    "build:pages": "VITE_BASE_PATH=/tav-press/ npm run build && node scripts/prepare-pages-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:seo": "node --test tests/seo.test.mjs",
    "test:pages": "node --test tests/pages.test.mjs"
  },
  "dependencies": {
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/roboto-condensed": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  }
}
